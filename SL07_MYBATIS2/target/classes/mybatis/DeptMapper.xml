<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.doit.ik.mapper.DeptMapper">
	<!-- //부서 조회 ArrayList<DeptDTO> selectDept(); -->

	<!-- <select id="selectDept" resultType="org.doit.ik.domain.DeptDTO"></select> -->
	<select id="selectDept" resultType="DeptDTOAlias">
		SELECT d.deptno, dname, loc
		, COUNT(e.empno) numberOfEmps
		FROM dept d FULL JOIN emp e ON d.deptno = e.deptno
		GROUP BY d.deptno, dname, loc
		ORDER BY d.deptno ASC
	</select>
	
	<!-- // 부서추가 추상 메서드 int insertDept(DeptDTO dto); -->
	<insert id="insertDept"
		parameterType="org.doit.ik.domain.DeptDTO">
		INSERT INTO dept ( deptno, dname, loc )
		VALUES ( #{deptno} , #{dname} , #{loc} )
	</insert>

	<!-- // 부서 삭제 추상 메서드 int deleteDept( @Param("deptno") int deptno); // Integer.deptno -->
	<delete id="deleteDept" parameterType="int">
	Delete FROM dept
	WHERE deptno = #{deptno}
	
	</delete>
</mapper>