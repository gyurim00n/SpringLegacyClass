<?xml version="1.0" encoding="UTF-8"?>
 <!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.doit.ik.mapper.scott.EmpMapper">
	<!-- ArrayList<EmpDTO> selectEmp() <select id="selectEmp" resultType="org.doit.ik.domain.scott.EmpDTO"> 
		SELECT * FROM emp ORDER BY deptno ASC </select> -->
		
		
	<select id="selectEmp"
		resultType="org.doit.ik.domain.scott.EmpDTO">
		SELECT * FROM emp
		<where>
			<if test="array != null and array.length > 0">

				<foreach collection="array" item="deptno" open="deptno IN ("
					close=")" separator=",">
					#{deptno}
					</foreach>

			</if>
		</where>
	</select>
	
	
