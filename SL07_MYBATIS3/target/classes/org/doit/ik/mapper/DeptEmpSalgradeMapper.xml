<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
  
 <mapper namespace="org.doit.ik.mapper.DeptEmpSalgradeMapper"> 
 
 <resultMap type="DeptEmpSalgradeDTOAlias" id="deptEmpResultMap">
 	<id property="empno" column="empno"/>
 	<id property="deptno" column="deptno"/>
 	<id property="dname" column="dname"/>
 	<id property="ename" column="ename"/>
 	<id property="job" column="job"/>
 	<id property="hiredate" column="hiredate"/>
 	<id property="sal" column="sal"/>
 	<id property="grade" column="grade"/>
 </resultMap>
 
 <!--  List<> getDeptEmpInfo(); -->
 <select id="getDeptEmpInfo" resultMap="deptEmpResultMap">
 
 SELECT d.deptno, dname, empno, ename, job, hiredate, sal, grade
    FROM emp e JOIN dept d      ON d.deptno = e.deptno
               JOIN salgrade s ON sal BETWEEN losal AND hisal
    ORDER BY d.deptno ASC
 </select>

 </mapper>