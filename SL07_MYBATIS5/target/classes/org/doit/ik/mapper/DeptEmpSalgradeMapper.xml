<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.doit.ik.mapper.DeptEmpSalgradeMapper">

   <!-- List<DeptEmpSalgradeDTO> getDept(); -->
   <select id="getDept" resultType="DeptEmpSalgradeDTOAlias">
     SELECT *
      FROM dept
      ORDER BY deptno ASC   
   </select>
   

   <!-- List<EmpDTO> getEmpOfDept(int deptno); -->
   <resultMap type="org.doit.ik.domain.EmpDTO" id="empResultMap">
            
         <id property="empno" column="empno" />
           <result property="ename" column="ename" />
           <result property="job" column="job" />
           <result property="hiredate" column="hiredate" />
           <result property="sal" column="sal" />
         
         <association property="salgradeDTO" javaType="org.doit.ik.domain.SalgradeDTO">
            <result property="grade" column="grade" />
         </association>
      
   </resultMap>
   
   <!-- List<?> getDeptEmpInfo(); -->
   <select id="getEmpOfDept" resultMap="empResultMap">
     SELECT empno, ename, job, hiredate, sal ,   grade
      FROM emp e JOIN salgrade s ON sal BETWEEN losal AND hisal
      WHERE deptno = #{deptno}   
   </select>

</mapper>
 