<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.doit.ik.mapper.BoardMapper">
	<!-- //[1]게시글 목록 List<BoardVO> getList(); -->

	<select id="getList" resultType="org.doit.ik.domain.BoardVO">
  
	 <![CDATA[
		 SELECT *
		 FROM tbl_board
		 WHERE bno > 0 
		 ORDER BY bno DESC
	 ]]>


		<!-- //<![CDATA[ ... ]]>의 역할 이 기호 안에 들어간 텍스트는 XML 파서가 문법 검사를 하지 않고, 순수한 
			문자열(Character Data)로 그대로 통과시키라는 의미입니다. 따라서 > 나 < 같은 기호를 마음껏 안전하게 사용할 수 있습니다. -->

		<!-- 1. 인덱스(Index) 활용 유도 (성능 최적화) 2. 동적 쿼리(WHERE절)를 붙이기 위한 뼈대 역할 -->
	</select>




	<!-- 2. 게시글 쓰기 int insert(BoardVO boardVO) -->

	<insert id="insert" parameterType="org.doit.ik.domain.BoardVO">
		INSERT INTO tbl_board (bno, title, content, writer)
		VALUES (seq_board.NEXTVAL, #{title}, #{content}, #{writer})

	</insert>


	<!-- int insertSelectKey(BoardVO boardVO); -->
	<insert id="insertSelectKey">
		<selectKey order="BEFORE" resultType="long" keyProperty="bno">
			SELECT seq_board.nextval
			FROM dual
		</selectKey>
		INSERT INTO tbl_board (bno, title, content, writer)
		VALUES ( #{bno}, #{title}, #{content}, #{writer})
	</insert>
	
	<!-- BoardVO read(Long bno); -->
	<select id="read"  resultType="org.doit.ik.domain.BoardVO" parameterType="long">
	 SELECT *
		 FROM tbl_board
		 WHERE bno = #{bno}
		 ORDER BY bno DESC
	
	</select>
	
	
	<!--int delte(@Param("bno") Long bno);  -->
	<delete id="delete">
	DELETE FROM tbl_board
	WHERE bno = #{bno}
	
	</delete>

</mapper>